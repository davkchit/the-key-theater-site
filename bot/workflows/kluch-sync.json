    {
      "id": "81cb4b27-0f14-4846-a83b-1db7a3027802",
      "name": "Скачать знание с сайта",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.SITE_URL || 'http://127.0.0.1:4173') + '/knowledge.json' }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "0dfd28cd-15f3-4e9e-a131-75bc9be319cf",
      "name": "Проверить и сравнить",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "const k = $input.first().json\n// a half-downloaded or error page must never overwrite a working copy\nconst ok = k && Array.isArray(k.afisha) && Array.isArray(k.shows) && Array.isArray(k.courses) && Array.isArray(k.faq) && k.faq.some((s) => s.always)\nif (!ok) return [{ json: { skip: true, reason: \"скачанное знание не похоже на знание — прошлая копия оставлена\" } }]\n// only real columns here: the row is written with autoMapInputData\nreturn [{ json: { slot: \"current\", built_at: String(k.builtAt || \"\"), fetched_at: new Date().toISOString(), json: JSON.stringify(k) } }]"
      }
    },
    {
      "id": "33c4b10a-1ca9-4cb2-a1a7-9c505c6866e1",
      "name": "Годится?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 2,
        "output": "={{ $json.skip ? 1 : 0 }}"
      }
    },
    {
      "id": "fddbbf6f-0e8d-4b8d-a138-d10313785486",
      "name": "Сохранить знание",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        960,
        220
      ],
      "parameters": {
        "resource": "row",
        "operation": "upsert",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "kluch_knowledge"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "slot",
              "condition": "eq",
              "keyValue": "current"
            }
          ]
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        }
      }
    },
    {
      "id": "2b1f653c-4bdb-4a9e-ad9d-e160315bffcc",
      "name": "Сигнал разработчику",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        380
      ],
      "parameters": {
        "jsCode": "const reason = $input.first().json.reason || 'не удалось скачать знание с сайта'\nconst store = $getWorkflowStaticData('global')\nconst now = Date.now()\n// one message per six hours, not one per failed attempt\nif (store.lastAlarm && now - store.lastAlarm < 6 * 60 * 60 * 1000) return []\nstore.lastAlarm = now\nreturn [{ json: { chat_id: $env.ADMIN_CHAT_ID, text: '⚠️ Бот «Ключ»: знание не обновляется с сайта.\\n' + reason + '\\nОтвечаю по последней копии.' } }]"
      }
    },
    {
      "id": "89a88342-4323-443b-af7f-d66a46eec25a",
      "name": "Написать администратору",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        380
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.TELEGRAM_API_BASE || 'https://api.telegram.org') + '/bot' + $env.TELEGRAM_BOT_TOKEN + '/sendMessage' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 10000
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
